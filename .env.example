# Required: a Frihet API key (starts with fri_).
# Generate one at https://app.frihet.io/settings/api
# The plugin never logs, prints, or stores this value outside the user's
# Hermes-managed secret directory.
FRIHET_API_KEY=

# Optional: override the canonical Frihet MCP endpoint.
# Default: https://mcp.frihet.io/mcp
# Only change this if Frihet publishes a new endpoint or you run a private
# mirror. If unsure, leave this commented out.
# FRIHET_MCP_URL=https://mcp.frihet.io/mcp

# Optional: timeout for the MCP readiness probe used by `doctor`.
# Default: 10 seconds.
# FRIHET_MCP_TIMEOUT_SECONDS=10